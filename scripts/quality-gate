#!/usr/bin/env bash
set -euo pipefail

ROOT="$(CDPATH= cd -- "$(dirname -- "$0")/.." && pwd)"
QUALITY_DIR="$ROOT/build/quality"
mkdir -p "$QUALITY_DIR/previews" "$QUALITY_DIR/exports" "$QUALITY_DIR/service" "$QUALITY_DIR/wheel"
export PYTHONPATH="$ROOT"

GODOT_BIN="$(printenv VFXFORGE_GODOT 2>/dev/null || true)"
if [[ -z "$GODOT_BIN" ]]; then
  if command -v godot >/dev/null 2>&1; then
    GODOT_BIN="$(command -v godot)"
  elif command -v godot4 >/dev/null 2>&1; then
    GODOT_BIN="$(command -v godot4)"
  elif [[ -x "$ROOT/.tools/godot/Godot_v4.7.2-stable_linux.x86_64" ]]; then
    GODOT_BIN="$ROOT/.tools/godot/Godot_v4.7.2-stable_linux.x86_64"
  fi
fi
if [[ -n "$GODOT_BIN" ]]; then
  export VFXFORGE_GODOT="$GODOT_BIN"
fi

echo "[1/11] Python model, CLI, renderer, and service tests"
python3 -m unittest tests.test_model tests.test_cli tests.test_renderer_export tests.test_service tests.test_service_hardening tests.test_schema_contract tests.test_service_matrix -v

echo "[2/11] User-facing CLI, Godot export, and GUI E2E"
python3 -m unittest tests.test_user_e2e -v

echo "[3/11] Batch schema validation"
python3 -m vfxforge.cli validate "$ROOT/examples" --json > "$QUALITY_DIR/validate.json"

echo "[4/11] Deterministic PNG previews"
python3 -m vfxforge.cli render-preview "$ROOT/examples" \
  --output "$QUALITY_DIR/previews" --time 0.6 --camera mmo --json > "$QUALITY_DIR/render.json"
preview_count="$(find "$QUALITY_DIR/previews" -maxdepth 1 -type f -name '*.png' | wc -l)"
test "$preview_count" -eq 8

if [[ -n "$GODOT_BIN" ]]; then
  echo "[5/11] Godot editor parse/startup smoke"
  "$GODOT_BIN" --headless --editor --path "$ROOT" --quit > "$QUALITY_DIR/godot-editor.log" 2>&1
  "$GODOT_BIN" --headless --path "$ROOT" --quit-after 2 > "$QUALITY_DIR/godot-gui-startup.log" 2>&1
  echo "[6/11] Godot export and clean-project smoke"
  python3 -m vfxforge.cli export "$ROOT/examples" --output "$QUALITY_DIR/exports" --json > "$QUALITY_DIR/export.json"
else
  echo "[5/11] Godot editor parse/startup smoke: SKIPPED (Godot 4.x not found)"
  echo "[6/11] Godot export smoke: SKIPPED (Godot 4.x not found)"
  python3 -m vfxforge.cli export "$ROOT/examples" --output "$QUALITY_DIR/exports" --no-smoke-test --json > "$QUALITY_DIR/export.json"
fi

manifest_count="$(find "$QUALITY_DIR/exports" -name 'export_manifest.json' -type f | wc -l)"
test "$manifest_count" -eq 8

echo "[7/11] JSON Schema validation"
python3 - <<'PY'
from pathlib import Path
from vfxforge.schema_validate import validate_file

root = Path('.')
for path in sorted((root / 'recipes').glob('*.json')):
    validate_file(path, 'vfx.recipe.schema.json')
for path in sorted((root / 'policies').glob('*.json')):
    validate_file(path, 'vfx.policy.schema.json')
for path in sorted((root / 'examples' / 'requests').glob('*.vfxrequest.json')):
    validate_file(path, 'vfx.request.schema.json')
print('JSON Schema validation OK')
PY

echo "[8/11] Default-policy service forge matrix"
rm -rf "$QUALITY_DIR/service"
mkdir -p "$QUALITY_DIR/service"
python3 -m vfxforge.cli forge --request examples/requests/fire_impact.vfxrequest.json --policy default --workspace "$QUALITY_DIR/service/default" --no-export --json > "$QUALITY_DIR/forge_fire.json"
python3 -m vfxforge.cli forge --request examples/requests/boss_line_sweep.vfxrequest.json --policy enigma --workspace "$QUALITY_DIR/service/enigma_no_export" --no-export --json > "$QUALITY_DIR/forge_boss_no_export.json" || true
python3 - <<'PY'
import json
from pathlib import Path

from vfxforge.service.matrix import iter_recipe_requests
from vfxforge.service.pipeline import forge

def load_cli(path):
    payload = json.loads(Path(path).read_text(encoding='utf-8'))
    return payload.get('data', payload)

fire = load_cli('build/quality/forge_fire.json')
boss = load_cli('build/quality/forge_boss_no_export.json')
assert fire['production_ready'] is True, fire
assert boss['production_ready'] is False, boss
assert any(item.get('code') == 'PRODUCTION_EXPORT_NOT_RUN' for item in boss.get('review_reasons', [])), boss

quality = Path('build/quality/service')
for recipe_id, request, _recipe in iter_recipe_requests():
    result = forge(request, policy_id='default', workspace=quality / f'default_{recipe_id}', export=False)
    assert result['production_ready'] is True, (recipe_id, result.get('status'), result.get('errors') or result.get('review_reasons'))
    (quality / f'default_{recipe_id}.json').write_text(json.dumps(result, indent=2) + '\n', encoding='utf-8')
print('default recipe matrix OK')
PY

echo "[9/11] Enigma library production path"
if [[ -z "$GODOT_BIN" ]]; then
  echo "Enigma library gate FAILED: Godot 4.x is required for host-library production verification." >&2
  exit 1
fi

python3 - <<'PY'
import json
from pathlib import Path

from vfxforge.service.matrix import iter_recipe_requests
from vfxforge.service.pipeline import forge

quality = Path('build/quality/service/enigma_library')
quality.mkdir(parents=True, exist_ok=True)
for recipe_id, request, _recipe in iter_recipe_requests():
    effect_id = request['effect_id']
    result = forge(
        request,
        policy_id='enigma',
        workspace=quality / effect_id,
        export=True,
        export_mode='library',
        resource_root=f'res://generated/vfx/{effect_id}',
        shared_runtime_path='res://generated/vfx/_runtime/vfx_runtime.gd',
        allow_replace=True,
    )
    (quality / f'{effect_id}.json').write_text(json.dumps(result, indent=2) + '\n', encoding='utf-8')
    assert result.get('production_ready') is True, (recipe_id, result.get('status'), result.get('errors') or result.get('review_reasons'))
    host = result.get('export_validation', {}).get('host_smoke_test', {})
    assert host.get('status') == 'passed', (recipe_id, host)
    checkpoints = host.get('checkpoints') or result.get('export_validation', {})
    print(f'enigma library OK {recipe_id} ({effect_id})')
print('enigma library matrix OK')
PY

echo "[10/11] Wheel install smoke"
python3 -m pip wheel "$ROOT" -w "$QUALITY_DIR/wheel" --no-deps -q
WHEEL_PATH="$(ls -1 "$QUALITY_DIR/wheel"/vfxforge-*.whl | head -n 1)"
rm -rf "$QUALITY_DIR/wheel/site"
python3 -m pip install "$WHEEL_PATH" --target "$QUALITY_DIR/wheel/site" -q
PYTHONPATH="$QUALITY_DIR/wheel/site" python3 -m vfxforge.cli recipes list --json > "$QUALITY_DIR/wheel/recipes.json"
PYTHONPATH="$QUALITY_DIR/wheel/site" python3 -m vfxforge.cli policies show enigma --json > "$QUALITY_DIR/wheel/policy.json"
PYTHONPATH="$QUALITY_DIR/wheel/site" python3 -m vfxforge.cli plan --request examples/requests/fire_impact.vfxrequest.json --policy default --json > "$QUALITY_DIR/wheel/plan.json"
PYTHONPATH="$QUALITY_DIR/wheel/site" python3 -m vfxforge.cli forge --request examples/requests/fire_impact.vfxrequest.json --policy default --workspace "$QUALITY_DIR/wheel/service" --no-export --json > "$QUALITY_DIR/wheel/forge.json"

echo "[11/11] Artifact checks"
test -s "$QUALITY_DIR/validate.json"
test -s "$QUALITY_DIR/render.json"
test -s "$QUALITY_DIR/export.json"
test -f "$QUALITY_DIR/exports/portal/meshes/forge_totem.obj"
test -s "$QUALITY_DIR/wheel/recipes.json"
test -s "$QUALITY_DIR/wheel/forge.json"
python3 - "$QUALITY_DIR/exports/portal/export_manifest.json" <<'PY'
import json
import sys
from pathlib import Path

manifest = json.loads(Path(sys.argv[1]).read_text(encoding="utf-8"))
assert manifest["copied_meshes"] == ["meshes/forge_totem.obj"]
assert manifest["smoke_test"]["status"] in {"passed", "skipped", "not_requested"}
PY
echo "QUALITY GATE: PASS"
